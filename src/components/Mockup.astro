---
import type { App } from "../data/apps";
import { format, getDict, type Locale } from "../i18n";

interface Props {
  app: App;
  lang: Locale;
}

const { app, lang } = Astro.props;
const t = getDict(lang);
const [glowA, glowB] = app.glow;
const alt = format(t.ui.mockupAlt, { name: app.name });
---

<div
  class="relative h-[220px] w-full overflow-hidden rounded-[20px] md:h-[300px]"
  style="background-image: linear-gradient(32deg, #2A2585 15%, #17144F 85%)"
>
  <!-- capa interior: se amplía suavemente al pasar el cursor sobre la tarjeta -->
  <div class="absolute inset-0 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/card:scale-[1.05] group-focus-within/card:scale-[1.05] motion-reduce:transition-none motion-reduce:group-hover/card:scale-100">
  <!-- brillos con los colores del logo -->
  <span
    aria-hidden="true"
    class="absolute -left-[15%] -top-[35%] aspect-square h-[110%] rounded-full opacity-55 blur-[90px]"
    style={`background:${glowA}`}></span>
  <span
    aria-hidden="true"
    class="absolute -bottom-[20%] -right-[15%] aspect-square h-[110%] rounded-full opacity-55 blur-[90px]"
    style={`background:${glowB}`}></span>

  {
    app.mockup === "window" && (
      <>
        <div class="absolute left-[14%] top-[10%] w-[72%] overflow-hidden rounded-[10px] bg-[#ECEEF5] opacity-40 shadow-[0_18px_36px_rgb(0_0_26/0.45)]" aria-hidden="true">
          <div class="h-4 md:h-5" />
          <img src={app.screens[0]} alt="" class="block w-full" loading="lazy" decoding="async" />
        </div>
        <figure class="absolute left-[10%] top-[18%] m-0 w-[80%] overflow-hidden rounded-[10px] bg-[#ECEEF5] shadow-[0_18px_36px_rgb(0_0_26/0.45)]">
          <div class="relative h-4 md:h-5">
            <span class="absolute left-2.5 top-[7px] flex gap-1" aria-hidden="true">
              <i class="size-1.5 rounded-full bg-[#FF5F57]" />
              <i class="size-1.5 rounded-full bg-[#FEBC2E]" />
              <i class="size-1.5 rounded-full bg-[#28C840]" />
            </span>
            <span class="absolute left-[30%] top-[5px] h-2.5 w-[40%] rounded-full bg-white" aria-hidden="true" />
          </div>
          <img src={app.screens[0]} alt={alt} class="block w-full" loading="lazy" decoding="async" />
        </figure>
      </>
    )
  }

  {
    app.mockup === "phones" && (
      <>
        <div
          class="absolute left-[16%] top-[18%] h-[86%] -rotate-[8deg] overflow-hidden rounded-[22px] border border-white/20 bg-[#0B0B1A] p-1.5 opacity-85 shadow-[0_16px_32px_rgb(0_0_26/0.5)]"
          style={`aspect-ratio:${app.ratio.toFixed(4)}`}
          aria-hidden="true"
        >
          <img src={app.screens[1]} alt="" class="block size-full rounded-[17px] object-cover" loading="lazy" decoding="async" />
        </div>
        <div
          class="absolute left-[40%] top-[7%] h-[86%] overflow-hidden rounded-[22px] border border-white/20 bg-[#0B0B1A] p-1.5 shadow-[0_16px_32px_rgb(0_0_26/0.5)]"
          style={`aspect-ratio:${app.ratio.toFixed(4)}`}
        >
          <img src={app.screens[0]} alt={alt} class="block size-full rounded-[17px] object-cover" loading="lazy" decoding="async" />
          <span class="absolute left-1/2 top-2.5 h-1.5 w-7 -translate-x-1/2 rounded-full bg-[#0B0B1A]" aria-hidden="true" />
        </div>
      </>
    )
  }

  {
    app.mockup === "pda" && (
      <img
        src={app.screens[0]}
        alt={alt}
        class="absolute left-1/2 top-[3%] h-full -translate-x-1/2 object-contain drop-shadow-[0_20px_36px_rgb(0_0_26/0.5)]"
        loading="lazy"
        decoding="async"
      />
    )
  }

  {
    app.mockup === "logo" && (
      <>
        <span class="absolute left-1/2 top-1/2 size-[110%] -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/20" aria-hidden="true" />
        <span class="absolute left-1/2 top-1/2 size-[82%] -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/20" aria-hidden="true" />
        <span class="absolute left-1/2 top-1/2 size-[55%] -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/20" aria-hidden="true" />
        <div class="absolute left-1/2 top-1/2 w-[46%] -translate-x-1/2 -translate-y-1/2 rounded-[18px] bg-white p-3 shadow-[0_14px_30px_rgb(0_0_26/0.4)]">
          <img src={app.logo.src} alt={format(t.ui.logoAlt, { name: app.name })} width={app.logo.w} height={app.logo.h} class="block w-full" loading="lazy" decoding="async" />
        </div>
      </>
    )
  }
  </div>
</div>
