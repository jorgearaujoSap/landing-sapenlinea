---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  class?: string;
  onDark?: boolean;
}

const { eyebrow, title, description, class: className, onDark = false } = Astro.props;
---

<div data-reveal class:list={["mx-auto flex max-w-[760px] flex-col items-center gap-3 text-center", className]}>
  <slot name="before" />
  <p class:list={["t-eyebrow", onDark ? "text-on-brand" : "text-brand"]}>{eyebrow}</p>
  <h2 class:list={["t-h2", onDark ? "text-on-brand" : "text-ink"]}>{title}</h2>
  {description && <p class="t-lead max-w-[680px] text-muted">{description}</p>}
</div>
