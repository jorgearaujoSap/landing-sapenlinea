---
import { getDict, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { about } = getDict(lang);
---

<section id="nosotros" class="bg-surface py-14 md:py-32">
  <div class="mx-auto grid max-w-[1120px] grid-cols-1 items-center gap-10 px-5 md:px-10 lg:grid-cols-2 lg:gap-16 xl:px-0">
    <div data-reveal class="flex flex-col gap-4">
      <p class="t-eyebrow text-brand">{about.eyebrow}</p>
      <h2 class="t-h2 text-ink">{about.title}</h2>
      <p class="text-base leading-normal text-muted">{about.text}</p>
    </div>
    <figure
      data-reveal="scale"
      class="m-0 aspect-[4/5] w-full max-w-[529px] overflow-hidden rounded-3xl bg-surface shadow-card lg:justify-self-end"
    >
      <img
        src="/assets/about/team.webp"
        alt={about.imageAlt}
        width="974"
        height="1600"
        class="size-full object-cover object-[50%_8%]"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>
