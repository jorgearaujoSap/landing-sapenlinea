---
interface Props {
  variant?: "primary" | "secondary";
  size?: "default" | "sm";
  href?: string;
  type?: "button" | "submit";
  class?: string;
  [key: string]: unknown;
}

const { variant = "primary", size = "default", href, type = "button", class: className, ...rest } = Astro.props;

const base =
  "t-button inline-flex items-center justify-center gap-2 rounded-full transition-colors duration-200 disabled:opacity-45 disabled:pointer-events-none";
const sizes = { default: "px-7 py-4", sm: "px-5 py-2.5" };
const variants = {
  primary: "bg-brand text-on-brand shadow-brand hover:bg-brand-hover dark:text-page",
  secondary: "bg-surface text-ink hover:bg-line",
};
const classes = [base, sizes[size], variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
